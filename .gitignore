# Vivado 工程文件与运行目录
# 注意：*.xpr 内含本机绝对路径与用户配置，不入库。
# 工程请用 verify/ 下的 TCL 脚本重建。
*.xpr
*.xsa
*.xpe
*.xpr.bak
*.runs/
*.cache/
*.hw/
*.sim/
*.ip_user_files/
*.srcs/utils/
.Xil/
xsim.dir/
webtalk/
webtalk_*
*.wdb
*.wcfg
*.vcd

# Vivado 日志、journal、报告
*.jou
*.log
*.str
*.pb
*.debug
*.rpt

# Vivado 崩溃备份
vivado_*.backup.*
*.backup.*

# 比特流与烧写文件
*.bit
*.bin
*.mcs
*.prm
*.ltx
*.rbt

# 老式 ISE 残留
*.bld
*.ncd
*.ngd
*.xwbt
*.mrp
*.pad
*.par
*.twr
*.unroutes
*.xpi
*.xst

# ============================================================
# IP 核：只保留 .xci 与手写/必需文件，其余由 Vivado 重新生成
# ============================================================
cpu31-test.srcs/sources_1/ip/.Xil/
cpu31-test.srcs/sources_1/ip/*/.Xil/
cpu31-test.srcs/sources_1/ip/*/dist_mem_gen_v8_0_10/
cpu31-test.srcs/sources_1/ip/*/doc/
cpu31-test.srcs/sources_1/ip/*/synth/
cpu31-test.srcs/sources_1/ip/*/*.veo
cpu31-test.srcs/sources_1/ip/*/*.vho
cpu31-test.srcs/sources_1/ip/*/*.xml
cpu31-test.srcs/sources_1/ip/*/*_ooc.xdc
cpu31-test.srcs/sources_1/ip/*/*_sim_netlist.v
cpu31-test.srcs/sources_1/ip/*/*_sim_netlist.vhdl
cpu31-test.srcs/sources_1/ip/*/*_stub.vhdl
cpu31-test.srcs/sources_1/ip/*/usage_statistics_webtalk.*
# IP 目录下的 coe 是 verify/coe/ 的副本，保留 verify/coe/ 作为唯一来源
cpu31-test.srcs/sources_1/ip/*/*.coe
# 废弃的板级指令存储器分支
cpu31-test.srcs/sources_1/ip/imem_board/

# ============================================================
# 课程资料：教师提供的 PDF，不对外分发
